[Unit]
Description=Drone Onboard Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/uav-opl
ExecStart=/bin/bash /home/pi/uav-opl/src/launchers/start.sh
Environment=PYTHONUNBUFFERED=1
KillSignal=SIGINT
TimeoutStopSec=10
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target