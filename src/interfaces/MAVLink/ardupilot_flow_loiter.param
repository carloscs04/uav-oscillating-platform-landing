# ArduPilot (ArduCopter 4.7) parameters for indoor Loiter with:
#   - optical flow from the Pi camera, sent as MAVLink OPTICAL_FLOW (msg 100)
#   - VL53L1X rangefinder, sent as MAVLink DISTANCE_SENSOR (pointing down)
#   - no GPS, no compass
#
# QGroundControl: load ardupilot_flow_loiter_qgc.params instead (same values, QGC
# format, generated from this file with: python -m src.interfaces.MAVLink.flow_check).
# Mission Planner: Config > Full Parameter List > Load from file.
# Then REBOOT the Pixhawk. The onboard 'flowcheck' command compares the live values
# with this file. Lines are NAME,VALUE ; '#' lines are comments.

# --- EKF3 ---
AHRS_EKF_TYPE,3
EK3_ENABLE,1
# Horizontal position: none (EKF dead-reckons a relative position from flow velocity)
EK3_SRC1_POSXY,0
# Horizontal velocity: optical flow
EK3_SRC1_VELXY,5
# Height (source set 1, active at every boot): rangefinder (VL53L1X) = height above
# whatever is below the drone. Used for normal flights over the floor/tarp.
EK3_SRC1_POSZ,2
EK3_SRC1_VELZ,0
# Yaw: none (gyro only, slow drift; no compass indoors). See flowcheck notes.
EK3_SRC1_YAW,0
# Baro->rangefinder switching: off (the height source is chosen with the source sets)
EK3_RNG_USE_HGT,-1
# --- Source set 2: same as set 1 but HEIGHT FROM THE BAROMETER, for flights over the
# 1 m landing platform (with lidar height the drone would climb 1 m over it, and lose
# the lidar when it leaves the platform at ~2 m). Selected from the master panel with
# 'heightsrc baro' (disarmed only); every Pixhawk boot and every Pi restart goes back
# to set 1 (lidar). The lidar is still used for flow scaling, the LAND slow-down and
# the Pi's GUIDED_NOGPS controller. Set 2 defaults to NO flow, so everything is listed.
EK3_SRC2_POSXY,0
EK3_SRC2_VELXY,5
EK3_SRC2_POSZ,1
EK3_SRC2_VELZ,0
EK3_SRC2_YAW,0
# Surface tracking off: with baro height it would still follow the lidar and climb
# over the platform; with lidar height it has nothing to add. Needs a reboot.
SURFTRAK_MODE,0
# Use flow for navigation
EK3_FLOW_USE,1
# Camera + Pi + link delay in ms, measured with 'flowtest' (2026-11-21: ~50 ms)
EK3_FLOW_DELAY,50

# --- Optical flow (MAVLink) ---
FLOW_TYPE,5
# Axis mapping is done on the Pi (camera_driver/config.yaml), so keep 0 here.
FLOW_ORIENT_YAW,0
# Scale corrections (parts per thousand). Start at 0; 'flowtest' suggests values.
FLOW_FXSCALER,0
FLOW_FYSCALER,0

# --- Visual odometry: OFF (the Pi no longer sends VISION_POSITION_ESTIMATE;
# leaving it on gives "PreArm: VisOdom: not healthy" and blocks arming) ---
VISO_TYPE,0

# --- Rangefinder (MAVLink, pointing down) ---
RNGFND1_TYPE,10
RNGFND1_ORIENT,25
# Metres. VL53L1X is unreliable below 4 cm. Bench test 2026-11-21: over the bare
# floor it fails above ~1.4 m ("signal fail"); over white card it is 100% valid at
# 1.9 m. Fly over a light surface, below ~1.7 m.
# RNGFND1_MAX also sets the Loiter (optical flow) height ceiling in EKF3:
#   ceiling = max(0.7 * max_range - 1.0, 1.0) m, where max_range is the SMALLER of
#   RNGFND1_MAX and the max_distance the Pi sends in DISTANCE_SENSOR (4.0 m, VL53L1X
#   long mode). 4.0 -> 1.8 m ceiling, the most this lidar supports: it only reads the
#   white tarp up to ~2.0 m, and above that the height source is lost. (2.2 -> 1.0 m.)
RNGFND1_MIN,0.04
RNGFND1_MAX,4.0
# What the lidar reads with the drone standing on the floor (measured: ~0.088 m)
RNGFND1_GNDCLR,0.09

# --- No compass ---
COMPASS_ENABLE,0
COMPASS_USE,0
COMPASS_USE2,0
COMPASS_USE3,0

# --- Safety (debug_force_arm sets these to 0: restore before any real flight) ---
# ArduPilot 4.7+ (this vehicle runs 4.7.3): ARMING_SKIPCHK replaces ARMING_CHECK.
# Set bits = checks SKIPPED, so 0 = run every pre-arm check.
# (On ArduPilot 4.6 or older use ARMING_CHECK,1 instead.)
ARMING_SKIPCHK,0
# RC / throttle failsafe: 3 = always LAND (RTL needs a position; indoors, no GPS)
FS_THR_ENABLE,3
DISARM_DELAY,10

# --- Vertical position controller ---
# Throttle per unit of vertical-acceleration error. KEEP 0.05 (4.7 value on every vehicle).
# 2026-11-25 20:00: set to 0.5 (pre-4.7 default, assumed not rescaled): on takeoff the four
# motors pumped together 1150 <-> 1940 every ~0.1 s, it bounced and flipped (pitch 32 deg).
PSC_D_ACC_P,0.05

# --- Horizontal velocity controller (LOITER / GUIDED velocity) ---
# Flight 2026-11-25 22:24: with zero velocity asked the drone wobbled +-4 cm every ~2.5 s at
# 0.45 m and drifted up to ~10 cm/s; it followed the commands ~1 s late. P 1.4 / I 0.25 / D 0.25
# until then (ArduPilot defaults 2.0 / 1.0 / 0.5). flowtest 2026-11-26: flow scale ~1x and
# delay 35-45 ms, so EK3_FLOW_DELAY / FLOW_F?SCALER stay; one change per flight:
#   1) P 1.4 -> 1.8 (this file)   2) if better, I 0.25 -> 0.5   worse -> back to P 1.4
# Keep D at 0.25 (it amplifies the camera-flow noise).
PSC_NE_VEL_P,1.8
PSC_NE_VEL_I,0.25
PSC_NE_VEL_D,0.25
